rvest labor \u00D70.8, timber build labor \u00D70.85, mine and quarry \u00D71.3, clearing \u00D71.25"},{"kind":"risk","text":"smiths\u0027 injury hazard \u00D71.3 per figure (arsenic fumes)"},{"kind":"gate","text":"[Has: Arsenic ore]"}],"era":3,"flavor":"The garlic smoke made the hardest metal yet.","gates":[{"kind":"has","target":"Arsenic ore"}],"id":"MET-04","idx":319,"lineage":"MET","moment":"A smith coughs in grey smoke as a pale golden blade cools on the stone","name":"Arsenical Bronze","practice":[{"action":"smelt","share":50},{"action":"mine","share":50}],"requires":["MET-03","MIN-04"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":1717986918400},"effects":[{"id":"G-TINORE","kind":"good"},{"id":"G-TIN","kind":"good","note":"barter 40"},{"id":"G-BRONZE","kind":"good","note":"recipe alloy_bronze: 9 copper to 1 tin"},{"id":"G-TOOL10","kind":"good","note":"0.15 L, 24 ws"},{"action":"chop","kind":"method","mult":{"$fix":25769803776},"name":"Bronze axe","note":"alternate route: MET-04 defines the same rung","rung":6},{"kind":"rule","text":"mine works tin deposits (factor 0.5); recipes smelt_tin and alloy_bronze"},{"kind":"rule","text":"tool tier t10: as t9, service life 24 ws (a third less metal, ore and charcoal per year)"},{"kind":"gate","text":"[Has: Tin]"}],"era":3,"flavor":"One part tin to nine of copper, and the metal turns to gold.","gates":[{"kind":"has","target":"Tin"}],"id":"MET-05","idx":320,"lineage":"MET","moment":"A smith drops a pinch of grey tin into the crucible and the melt flashes gold","name":"Tin Bronze","practice":[{"action":"smelt","share":50},{"action":"trade","share":50}],"requires":["MET-03"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":3435973836800},"cost":800,"cost_reason":"docs/MVP/28 \u00A716: late era-3 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"id":"G-FINEBRONZE","kind":"good","note":"luxury, barter 30"},{"kind":"mod","op":"mult","stat":"wonder_build_labor","value":{"$fix":3865470566}},{"kind":"rule","text":"a bronze statue commemorates a second Legend per City, who keeps the bonus after death (ART-06\u0027s relief keeps one per settlement)"}],"era":3,"flavor":"The wax melts away; the bronze remembers every line.","id":"MET-06","idx":321,"lineage":"MET","moment":"A clay mould is broken open and a small bronze dancer stands inside it","name":"Lost-Wax Casting","practice":[{"action":"craft","share":50},{"action":"smelt","share":50}],"requires":["ART-06"],"requires_any":["MET-04","MET-05"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":1717986918400},"effects":[{"action":"pan_gold","kind":"unlock_action"},{"id":"G-GOLD","kind":"good","note":"luxury, barter 40"},{"kind":"mod","note":"gold and silver count double in the luxury Cohesion term","op":"set","stat":"gold_luxury_weight","value":2},{"kind":"gate","text":"[Seen: Gold or Silver]"}],"era":3,"flavor":"The metal that never tarnishes, for those who must not be forgotten.","gates":[{"kind":"seen","target":"Gold or Silver"}],"id":"MET-07","idx":322,"lineage":"MET","moment":"Gold dust settles in a fleece laid in a cold stream; a circlet is hammered from it","name":"Gold \u0026 Silver Working","practice":[{"action":"mine","share":50},{"action":"craft","share":50}],"requires":["MET-03","TRD-03"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":3435973836800},"cost":800,"cost_reason":"docs/MVP/28 \u00A716: late era-3 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"id":"G-IRONORE","kind":"good"},{"id":"G-IRON","kind":"good","note":"iron bloom, barter 15; recipe bloomery at a Smelter"},{"kind":"reveal","text":"iron deposits within 20 tiles of every own settlement"},{"kind":"rule","text":"mine works iron deposits; no iron tools before E4 (MET-09)"}],"era":3,"flavor":"A black, spitting lump that would one day outlast bronze.","id":"MET-08","idx":323,"lineage":"MET","moment":"A smith breaks open a clay furnace and drags out a glowing, sputtering bloom","name":"Bloomery Iron","practice":[{"action":"smelt","share":100}],"requires":["FIR-09"],"requires_any":["MET-04","MET-05"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":5153960755200},"effects":[{"id":"G-WROUGHT","kind":"good"},{"id":"G-TOOL11","kind":"good"},{"action":"chop","kind":"method","mult":9,"name":"iron_axe","rung":7},{"kind":"rule","text":"Apply T11 item modifiers from \u00A72.2; unlock forge_wrought and make_tool11 recipes."}],"era":4,"flavor":"Bloom becomes an edge for every hand.","id":"MET-09","idx":324,"lineage":"MET","moment":"Red-hot iron is hammered into an axe edge.","name":"Iron Tools","practice":[{"action":"smelt","share":100}],"requires":["MET-08"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":5153960755200},"effects":[{"id":"G-STEEL","kind":"good"},{"id":"G-TOOL12","kind":"good"},{"id":"G-ARMS4","kind":"good"},{"kind":"rule","text":"Unlock make_tool12; T12 durability is \u00D72 T11. WAR-08 iron arms strength is 2.4; MET-10 steel-edge arms strength is 3.0 (2.4 \u00D7 1.25 exactly once)."}],"era":4,"flavor":"Heat and water set the edge.","id":"MET-10","idx":325,"lineage":"MET","moment":"A blade hisses as it meets water.","name":"Quench \u0026 Temper","practice":[{"action":"smelt","share":100}],"requires":["MET-09"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":27487790694400},"effects":[{"id":"G-CSTEEL","kind":"good"},{"id":"G-ARMS5","kind":"good"},{"kind":"rule","text":"Recipes crucible_steel and make_crucible_arms. Crucible-steel arms strength is 3.6 (the MET-10 steel edge 3.0 x 1.2 exactly once; never stacked on top of it). Crucible steel is rare and a luxury trade good."}],"era":5,"flavor":"A small pot of fire makes the finest edge.","id":"MET-11","idx":326,"lineage":"MET","moment":"A crucible is lifted white-hot from the furnace.","name":"Crucible Steel","practice":[{"action":"smelt","share":100}],"requires":["MET-10","CER-08","TRD-07"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":32985348832000},"effects":[{"kind":"build","structure":"blast_furnace"},{"id":"G-CAST","kind":"good"},{"kind":"mod","note":"per bloomery batch in a town with a built blast furnace and a mill: x4 iron from x4 ore and x1 charcoal and x2 labor, so one-quarter charcoal and half the labor per litre (P, e5_power_oracle; draft F-T3 factor fit)","op":"mult","stat":"furnace_iron_output","value":{"$fix":17179869184}},{"kind":"rule","text":"A blast furnace works only in a smelting town with a forge and a mill (water mill or windmill) to drive its bellows. The furnace\u0027s iron is the same G-IRON the forge turns to wrought iron; cast-iron goods (pots, parts, cannon bodies) are made from it. Iron demand is capped by recipes, not open-ended. No coal exists before E6, so the furnace competes with homes and ships for forest."}],"era":5,"flavor":"The fire is driven until the iron runs.","id":"MET-12","idx":327,"lineage":"MET","moment":"Iron runs from the furnace in a bright stream.","name":"Blast Furnace \u0026 Cast Iron","practice":[{"action":"smelt","share":100}],"requires":["MET-10","NRG-03"],"status":"numeric","theme":"craft","type":"S"},{"cost":24000,"cost":{"$fix":103079215104000},"cost_reason":"docs/MVP/38 \u00A76 D9 and docs/MVP/28 \u00A716: depth-3 non-keystone E6 project; 2x EraBase 12000 x M 1.0.","effects":[{"kind":"mod","note":"a coke-fed blast furnace; iron per furnace-season, no charcoal (P)","op":"mult","stat":"furnace_iron_output","value":{"$fix":12884901888}},{"kind":"rule","text":"A coke-smelting batch (recipe coke_smelt) burns no charcoal: coke from a coke oven (FIR-12) replaces it, so forest stops limiting iron where coal can be mined or bought."}],"era":6,"flavor":"Coal has taken the place of the forest in the furnace.","id":"MET-13","idx":328,"lineage":"MET","moment":"A blast of coke fire turns a hearth white.","name":"Coke Smelting","practice":[{"action":"smelt","share":100}],"requires":["MET-12","FIR-12"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Wrought iron by the ton: rails, girders, boilers."}],"era":7,"id":"MET-14","idx":329,"lineage":"MET","name":"Puddling \u0026 Rolling Mills","requires":["MET-13","NRG-07"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"\u25B8 Steel: Converter \u00D710. Steel replaces iron in everything."}],"era":7,"id":"MET-15","idx":330,"lineage":"MET","name":"Bessemer Steel","requires":["MET-14","INQ-10"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Good: Aluminium (needs Bauxite). Light alloys for aviation and transmission lines."}],"era":8,"id":"MET-16","idx":331,"lineage":"MET","name":"Aluminium Smelting","requires":["MET-15","NRG-09","INQ-11"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Stainless steel and superalloys: machine durability \u00D72; jet engines; turbine blades."}],"era":8,"id":"MET-17","idx":332,"lineage":"MET","name":"Alloy Steels \u0026 Superalloys","requires":["MET-16","INQ-15"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Composites and closed-loop recycling: metal demand from mines \u221240%."}],"era":9,"id":"MET-18","idx":333,"lineage":"MET","name":"Advanced Materials \u0026 Recycling","requires":["MET-17","CHM-14","INQ-19"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":214748364800},"effects":[{"action":"collect_flint_ochre","kind":"unlock_action"},{"id":"G-FLINT","kind":"good"},{"id":"G-OCHRE","kind":"good"}],"era":1,"flavor":"The best stone hides where few look.","id":"MIN-01","idx":334,"lineage":"MIN","moment":"A scout pockets a lump of red earth and a dark flint nodule","name":"Flint \u0026 Ochre Seeking","practice":[{"action":"mine","share":50},{"action":"scout","share":50}],"requires":["STN-05"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":644245094400},"effects":[{"action":"mine_flint","kind":"unlock_action","note":"3 L/ws"}],"era":2,"flavor":"We dug for the best stone.","id":"MIN-02","idx":335,"lineage":"MIN","moment":"Antler picks chip at chalk at the bottom of a deep pit","name":"Flint Mines","practice":[{"action":"mine","share":100}],"requires":["MIN-01","STN-08"],"status":"numeric","theme":"craft","type":"D"},{"cost":300,"cost":{"$fix":1288490188800},"cost_reason":"docs/MVP/28 \u00A716: late era-2 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"action":"quarry","kind":"unlock_action","note":"2 L/ws"}],"era":2,"flavor":"The mountain gives us its bones.","id":"MIN-03","idx":336,"lineage":"MIN","moment":"A block is wedged loose from a rock face","name":"Quarrying","practice":[{"action":"mine","share":100}],"requires":["MIN-02"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":1717986918400},"effects":[{"action":"mine","kind":"method","mult":{"$fix":6442450944},"name":"Shaft","note":"opens depth-2 deposits; needs a Mine head","rung":1},{"kind":"reveal","text":"local prospecting identifies depth-2 metal lodes near discovered mineral outcrops"},{"id":"miner","kind":"role"},{"kind":"build","structure":"mine_head"},{"kind":"mod","note":"Open a mine sends 6 miners","op":"set","stat":"mining_camp_crew","value":6}],"era":3,"flavor":"We followed the green vein into the dark.","id":"MIN-04","idx":337,"lineage":"MIN","moment":"A miner is lowered on a rope into a timbered shaft, a lamp glowing below him","name":"Shaft Mining","practice":[{"action":"mine","share":100}],"requires":["MIN-03","MET-03","SOC-07"],"status":"numeric","theme":"craft","type":"M"},{"cost":800,"cost":{"$fix":3435973836800},"cost_reason":"docs/MVP/28 \u00A716: late era-3 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"action":"mine","kind":"method","mult":{"$fix":9663676416},"name":"Fire-setting","note":"\u00D71.5 on Shaft; 0.5 L wood per L ore","rung":2}],"era":3,"flavor":"Fire cracks what picks cannot.","id":"MIN-05","idx":338,"lineage":"MIN","moment":"A fire roars against a rock face; water is thrown on it and the stone splits with a crack","name":"Fire-Setting","practice":[{"action":"mine","share":50},{"action":"tend_fire","share":50}],"requires":["MIN-04","FIR-08"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":1717986918400},"effects":[{"action":"salt","kind":"unlock_action","note":"1 L/ws at salt deposits; coastal pans in Summer"},{"id":"G-SALT","kind":"good"},{"kind":"unlock","project":"FOD-07","text":"salting (FOD-07)"},{"kind":"gate","text":"[Seen: Salt]"}],"era":3,"flavor":"White gold from the earth and the sea.","gates":[{"kind":"seen","target":"Salt"}],"id":"MIN-06","idx":339,"lineage":"MIN","moment":"Women rake white crystals from a shallow pan as the last of the water dries","name":"Salt Works","practice":[{"action":"mine","share":100}],"requires":["MIN-03","FOD-02"],"status":"numeric","theme":"craft","type":"D"},{"cost":2400,"cost":{"$fix":10307921510400},"cost_reason":"docs/MVP/28 \u00A77: late Iron project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"rule","text":"Mine depth 2 with flooded-deposit access. Each flooded deposit requires a drainage installation (1 G-WOOD \u002B 0.2 G-CHAR, 2 ws) and upkeep of 0.1 G-CHAR per season while staffed; no new deposit is created."}],"era":4,"flavor":"The mine descends beyond the waterline.","id":"MIN-07","idx":340,"lineage":"MIN","moment":"A screw lifts pooled water from a lower gallery.","name":"Mine Drainage","practice":[{"action":"mine","share":100}],"requires":["MIN-05","MEC-05"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":27487790694400},"effects":[{"kind":"reveal","text":"Ore veins within the civilization\u0027s own territory become known."},{"kind":"reveal","text":"Coal deposits within the civilization\u0027s reach (25 at E5, 35 at E6) count as [Seen: Coal], so MIN-09 never depends on a surface seam showing (docs/MVP/38 D13)."},{"kind":"mod","note":"known deposits in own territory only","op":"mult","stat":"mine_yield","value":{"$fix":5368709120}}],"era":5,"flavor":"The mountain is read before it is dug.","id":"MIN-08","idx":341,"lineage":"MIN","moment":"Surveyors mark veins on a plan before a shovel is lifted.","name":"Mine Surveying","practice":[{"action":"mine","share":100}],"requires":["MIN-07","NUM-07"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":51539607552000},"effects":[{"id":"G-COAL","kind":"good"},{"kind":"build","structure":"coal_mine"},{"kind":"rule","text":"Coal is dug by staffed miners from seams 2 to 3 deep; deep seams flood without a pumping engine (NRG-06). Needs a coal deposit the civilization has seen."}],"era":6,"flavor":"The dark seams burn.","gates":[{"kind":"seen","target":"Coal"}],"id":"MIN-09","idx":342,"lineage":"MIN","moment":"A prospector turns a black lump in his hand and strikes a light.","name":"Coal Mining","practice":[{"action":"mine","share":100}],"requires":["MIN-08"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":51539607552000},"effects":[{"kind":"mod","note":"mine and quarry (P)","op":"mult","stat":"mine_quarry_output","value":{"$fix":8589934592}},{"kind":"rule","text":"Blasting consumes gunpowder (P 0.02 per litre mined), so mines compete with war for saltpeter and sulfur."}],"era":6,"flavor":"A fuse, a flash, and a face of rock comes down.","id":"MIN-10","idx":343,"lineage":"MIN","moment":"Miners shelter as a charge fires in a shaft.","name":"Black-Powder Blasting","practice":[{"action":"mine","share":100}],"requires":["MIN-09","CHM-07"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Depth tier 3: coal and ore yield \u00D72."}],"era":7,"id":"MIN-11","idx":344,"lineage":"MIN","name":"Steam Pumping","requires":["MIN-10","NRG-07"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"\u25B8 Mine \u00D72; tunnels for rail and canals."}],"era":7,"id":"MIN-12","idx":345,"lineage":"MIN","name":"Dynamite \u0026 Pneumatic Drills","requires":["MIN-11","CHM-11"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Oil seeps mark nearby fields. Good: Crude oil. Build: Oil well."}],"era":8,"gates":[{"kind":"seen","target":"Oil seep"}],"id":"MIN-13","idx":346,"lineage":"MIN","name":"Oil Drilling","requires":["MIN-12","INQ-13"],"status":"draft","theme":"craft","type":"D"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"\u25B8 Mine: Open pit \u00D73; labor \u221250%; scars terrain (\u002Bpollution)."}],"era":8,"id":"MIN-14","idx":347,"lineage":"MIN","name":"Open-Pit \u0026 Heavy Machinery","requires":["MIN-12","NRG-10"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Good: Rare earths and lithium, needed for batteries and electronics."}],"era":9,"id":"MIN-15","idx":348,"lineage":"MIN","name":"Rare Earths \u0026 Lithium","requires":["MIN-14","CHM-13","INQ-15"],"status":"draft","theme":"craft","type":"D"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Reveal: All deposits on the map (not only in your territory)."}],"era":9,"id":"MIN-16","idx":349,"lineage":"MIN","name":"Remote-Sensing Prospecting","requires":["MIN-15","WAY-13"],"status":"draft","theme":"craft","type":"M"},{"cost":300,"cost":{"$fix":1288490188800},"cost_reason":"docs/MVP/28 \u00A716: late era-2 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"action":"draft_oxen","kind":"unlock_action"},{"kind":"mod","note":"Farm and haul labor, \u221230%; needs cattle","op":"pct","stat":"farm_and_haul_labor","value":{"$fix":-1288490188}}],"era":2,"flavor":"Their strength, our purpose.","id":"NRG-01","idx":350,"lineage":"NRG","moment":"Oxen drag a sledge of stone","name":"Draft Animals","practice":[{"action":"herd","share":50},{"action":"work_animals","share":50}],"requires":["HUS-04"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":1717986918400},"effects":[{"kind":"mod","note":"ard: one ox pair per 6 fields instead of 4; cart load 6 \u2192 9 L","op":"mult","stat":"draft_animal_work","value":{"$fix":6442450944}}],"era":3,"flavor":"The yoke shares the load across two necks.","id":"NRG-02","idx":351,"lineage":"NRG","moment":"A wooden yoke is fitted across two oxen and the ard bites deeper","name":"Harness \u0026 Yoke","practice":[{"action":"work_animals","share":50},{"action":"farm","share":50}],"requires":["NRG-01","FIB-03"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":12369505812480},"cost":2880,"cost_reason":"docs/MVP/28 \u00A77: late Iron project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"build","structure":"water_mill"},{"kind":"rule","text":"At a built water mill on River [Near], grind output \u00D75 and enable water-powered eligible saw, bellows, and trip-hammer jobs. Mechanical labor only; no fuel substitution."}],"era":4,"flavor":"The current lends its strength to the mill.","gates":[{"kind":"near","target":"River"}],"id":"NRG-03","idx":352,"lineage":"NRG","moment":"A river turns a wheel beside the mill.","name":"Water Wheel","practice":[{"action":"work_animals","share":100}],"requires":["NRG-02","MEC-05"],"status":"numeric","theme":"craft","type":"S"},{"cost":{"$fix":27487790694400},"effects":[{"kind":"mod","note":"ploughing and hauling where the settlement holds horses","op":"mult","stat":"draft_power","value":{"$fix":8589934592}},{"kind":"rule","text":"Needs G-HORSE held in the settlement; ploughing labor halves where horses are available and is unchanged elsewhere."}],"era":5,"flavor":"The yoke moves from the neck to the shoulders.","id":"NRG-04","idx":353,"lineage":"NRG","moment":"A horse leans into a collar and the plough moves.","name":"Horse Collar","practice":[{"action":"work_animals","share":100}],"requires":["NRG-02","HUS-07"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":32985348832000},"effects":[{"kind":"build","structure":"windmill"},{"kind":"rule","text":"A built windmill supplies 4 power units at 80% availability on any open tile for grinding and mill-driven jobs, so milling no longer needs a river; drainage pumps reclaim wetland tiles to field only while a pump job is staffed."}],"era":5,"flavor":"The wind turns the grain to flour.","id":"NRG-05","idx":354,"lineage":"NRG","moment":"Sails turn on a ridge and the millstones begin.","name":"Windmill","practice":[{"action":"work_animals","share":50},{"action":"craft","share":50}],"requires":["NRG-03","MEC-07"],"status":"numeric","theme":"craft","type":"S"},{"cost":{"$fix":51539607552000},"effects":[{"kind":"build","structure":"atmospheric_engine"},{"id":"engineer","kind":"role"},{"action":"tend_engine","kind":"unlock_action"},{"kind":"rule","text":"An atmospheric engine burns coal for power-hours in the shared power ledger and pumps a flooded coal mine; with no coal or no engineer it is idle and shown so. Draft engine: 10 power units on 1 L coal per unit-season with 2 engineers (e6_power_oracle Part C: 6 units on 3 L coal loses labor at every town size). KEY-7 prerequisite."}],"era":6,"flavor":"Fire lifts water from the deep.","id":"NRG-06","idx":355,"lineage":"NRG","moment":"A great beam nods and a shaft begins to drain.","name":"Steam Engine","practice":[{"action":"tend_engine","share":100}],"requires":["NRG-05","MIN-09","MET-12"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Rotary steam power: factories, mills and ships run anywhere; output \u00D73 on powered work."}],"era":7,"id":"NRG-07","idx":356,"lineage":"NRG","name":"Watt Engine","requires":["NRG-06","MEC-09"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Good: Electricity (local). *KEY-8 prerequisite.*"}],"era":7,"id":"NRG-08","idx":357,"lineage":"NRG","name":"Electric Generator","requires":["NRG-07","INQ-11"],"status":"draft","theme":"craft","type":"D"},{"cost":{"$fix":8761733283500000},"effects":[{"kind":"prose","text":"Build: Power station, lines. Electric light and motors in all connected settlements: work \u002B20%, Insight \u002B10%."}],"era":8,"id":"NRG-09","idx":358,"lineage":"NRG","name":"Electric Grid","requires":["NRG-08","MET-14"],"status":"draft","theme":"craft","type":"S"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Portable power: tractors, trucks, cars, aircraft."}],"era":8,"id":"NRG-10","idx":359,"lineage":"NRG","name":"Internal Combustion Engine","requires":["NRG-07","MIN-13","INQ-12"],"status":"draft","theme":"craft","type":"D"},{"cost":{"$fix":8761733283500000},"effects":[{"kind":"prose","text":"Build: Dam [Near: River]. Clean power; floods \u2212; reservoir displaces tiles."}],"era":8,"id":"NRG-11","idx":360,"lineage":"NRG","name":"Hydroelectric Dams","requires":["NRG-09","BLD-14"],"status":"draft","theme":"craft","type":"S"},{"cost":{"$fix":8761733283500000},"effects":[{"kind":"prose","text":"Build: Reactor. Huge power, low pollution; small meltdown risk (lowered by INQ and GOV)."}],"era":8,"id":"NRG-12","idx":361,"lineage":"NRG","name":"Nuclear Fission Power","requires":["NRG-11","INQ-16"],"status":"draft","theme":"craft","type":"S"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Build: Solar field. Clean power, best in sunny biomes."}],"era":9,"id":"NRG-1