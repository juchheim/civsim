,"effects":[{"kind":"prose","text":"Soft power \u00D72; rival civilizations\u0027 Cohesion against you \u221210% (they like your culture). Lever: Beacon \u002B2."}],"era":9,"id":"ART-14","idx":30,"lineage":"ART","name":"Global Pop Culture","requires":["ART-13","COM-16"],"status":"draft","theme":"kin","type":"I"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Video games and virtual worlds: Cohesion \u002B; Commons Insight \u002B5% (a wink)."}],"era":9,"id":"ART-15","idx":31,"lineage":"ART","name":"Interactive Media","requires":["ART-14","MEC-15"],"status":"draft","theme":"kin","type":"D"},{"cost":{"$fix":141733920768},"effects":[{"action":"bury","kind":"unlock_action"},{"kind":"mod","note":"Cohesion loss per death, \u00D70.5","op":"mult","stat":"cohesion_loss_per_death","value":{"$fix":2147483648}},{"kind":"claim","text":"\u002B0.3, radius 2 around burial grounds"}],"era":0,"flavor":"They stay with us in the earth.","id":"BEL-01","idx":32,"lineage":"BEL","moment":"A body laid in a shallow grave, red ochre and a stone tool beside it","name":"Mourning \u0026 Burial","practice":[{"action":"ritual","share":100}],"requires":["SOC-01"],"status":"numeric","theme":"kin","type":"I"},{"cost":{"$fix":322122547200},"effects":[{"kind":"cohesion","value":3},{"kind":"build","structure":"totem"},{"kind":"claim","text":"\u002B0.3, radius 2 around totems"}],"era":1,"flavor":"Everything is alive and watching.","id":"BEL-02","idx":33,"lineage":"BEL","moment":"Offerings left at the foot of a great tree","name":"Animism \u0026 Totems","practice":[{"action":"ritual","share":100}],"requires":["BEL-01","ART-01"],"status":"numeric","theme":"kin","type":"I"},{"cost":{"$fix":171798691800},"effects":[{"id":"shaman","insight":12,"kind":"role","note":"heals as MED-01"},{"kind":"rule","text":"Morale floor in famine: Cohesion never below 25"}],"era":1,"flavor":"One of us walks between worlds.","id":"BEL-03","idx":34,"lineage":"BEL","moment":"A shaman drums at the edge of the 