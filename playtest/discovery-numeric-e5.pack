0000},"effects":[{"kind":"prose","text":"Rights and elections: Cohesion \u002B, Insight \u002B10%; revolution events \u2212."}],"era":7,"id":"GOV-13","idx":209,"lineage":"GOV","name":"Constitutional Democracy","requires":["GOV-12","LRN-09"],"status":"draft","theme":"kin","type":"I"},{"cost":{"$fix":10952166604800000},"effects":[{"kind":"prose","text":"Whole population participates: Cohesion \u002B15%, Commons Insight \u002B10%."}],"era":8,"id":"GOV-14","idx":210,"lineage":"GOV","name":"Universal Suffrage","requires":["GOV-13","LRN-10"],"status":"draft","theme":"kin","type":"I"},{"cost":{"$fix":57982058496000000},"effects":[{"kind":"prose","text":"E-government: admin cost \u221250%; Overreach nearly eliminated."}],"era":9,"id":"GOV-15","idx":211,"lineage":"GOV","name":"Digital Governance","requires":["GOV-14","COM-16"],"status":"draft","theme":"kin","type":"I"},{"cost":{"$fix":94489280512},"effects":[{"action":"scavenge","kind":"method","mult":{"$fix":6442450944},"name":"Power scavenging","rung":1},{"cap":"food","kind":"cap","mult":{"$fix":4810363371}}],"era":0,"flavor":"We took our share from the lions.","id":"HNT-01","idx":212,"lineage":"HNT","moment":"Shouting figures with clubs drive hyenas off a fresh kill","name":"Power Scavenging","practice":[{"action":"hunt","share":50},{"action":"fight","share":50}],"requires":[],"status":"numeric","theme":"kin","type":"M"},{"cost":44,"cost":{"$fix":188978561024},"cost_reason":"docs/MVP/28 \u00A716: late era-0 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"action":"hunt","kind":"unlock_action","note":"ambush"},{"action":"hunt","kind":"method","name":"Wooden spear","rate":{"$fix":6871947673},"rung":1,"unit":"R/ws"},{"cap":"food","kind":"cap","mult":{"$fix":4466765987}},{"id":"G-SPEAR","kind":"good"}],"era":0,"flavor":"Patience, then one thrust.","id":"HNT-02","idx":213,"lineage":"HNT","moment":"Hunters crouch in reeds by a watering hole, spears ready"