755200},"effects":[{"kind":"build","structure":"press"},{"kind":"unlock","text":"Unlock press, Archimedean screw, and water-wheel gearing; presses require MEC-05 and recipe inputs; enable mine drainage."}],"era":4,"flavor":"A measured turn moves water uphill.","id":"MEC-05","idx":289,"lineage":"MEC","moment":"Interlocking gears turn an endless screw.","name":"Gears \u0026 Screws","practice":[{"action":"build","share":100}],"requires":["MEC-04","NUM-07"],"status":"numeric","theme":"craft","type":"M"},{"cost":2880,"cost":{"$fix":12369505812480},"cost_reason":"docs/MVP/28 \u00A77: late Iron project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"build","structure":"crane"},{"kind":"rule","text":"Eligible large-structure and Wonder construction labor \u00D70.5 (build \u00D72), only for jobs staffed at a settlement with a crane."}],"era":4,"flavor":"The wheel lifts the weight of a wall.","id":"MEC-06","idx":290,"lineage":"MEC","moment":"Workers step inside a wheel and raise a block.","name":"Treadwheel Crane","practice":[{"action":"build","share":100}],"requires":["MEC-05"],"status":"numeric","theme":"craft","type":"S"},{"cost":{"$fix":27487790694400},"effects":[{"kind":"mod","note":"trip hammers, fulling stocks and bellows; only a worker holding a power unit","op":"mult","stat":"mill_craft_output","value":{"$fix":8589934592}},{"kind":"rule","text":"Power is ledgered: a water wheel supplies 5 power units, a windmill 4 at 80% availability, a horse gin 2 (P, docs 27 5.1). A powered craft worker\u0027s output is x2; a worker without a unit gets no multiplier."}],"era":5,"flavor":"A turning wheel learns to strike.","id":"MEC-07","idx":291,"lineage":"MEC","moment":"A cam lifts a hammer that falls by itself.","name":"Crank \u0026 Camshaft","practice":[{"action":"build","share":100}],"requires":["MEC-05","NRG-03"],"status":"numeric","theme":"craft","type":"M"},{"cost":{"$fix":27487790694400},"effects":[{"kind":"build","structure":"clock_tower"},{"kind":"mod","note":"only within 6 tiles of a built clock tower (P); not a global multiplier","op":"mult","stat":"scheduled_work","value":{"$fix":4509715660}},{"kind":"cohesion","note":"settlements within 6 tiles of a built clock tower","radius":6,"scope":"radius","value":2}],"era":5,"flavor":"Hours become a thing that can be counted aloud.","id":"MEC-08","idx":292,"lineage":"MEC","moment":"A bell strikes the hour across the market.","name":"Mechanical Clock","practice":[{"action":"build","share":100}],"requires":["MEC-07","NUM-06"],"status":"numeric","theme":"craft","type":"D"},{"cost":{"$fix":51539607552000},"effects":[{"id":"G-PARTS","kind":"good"},{"kind":"mod","note":"surveying and machine fits (P)","op":"mult","stat":"survey_accuracy","value":{"$fix":5153960755}},{"kind":"rule","text":"Enables chronometers (WAY-10) and textile machinery (FIB-12); parts are made at a forge from wrought iron and plate glass."}],"era":6,"flavor":"A part that fits needs no filing.","id":"MEC-09","idx":293,"lineage":"MEC","moment":"A maker checks a gear against a gauge to a hair.","name":"Precision Instruments","practice":[{"action":"build","share":100}],"requires":["MEC-08","CER-10"],"status":"numeric","theme":"craft","type":"M"},{"cost":36000,"cost":{"$fix":154618822656000},"cost_reason":"docs/MVP/38 \u00A76 D9 and docs/MVP/28 \u00A716: depth-3 non-keystone E6 project; 2x EraBase 12000 x I 1.5.","effects":[{"kind":"build","structure":"factory"},{"action":"factory_work","kind":"unlock_action"},{"kind":"mod","note":"in a staffed factory, scaled by the power it actually receives from the shared ledger (P)","op":"mult","stat":"craft_output_per_worker","value":{"$fix":8589934592}},{"kind":"rule","text":"A factory draws workers from the countryside (urban migration) and soots adjacent tiles; the pollution is a local state until KEY-7. KEY-7 prerequisite."},{"kind":"rule","text":"In the sim: a town of 120 or more with a water mill, windmill or fired engine raises one factory; twelve operatives leave other work to staff it; each recipe the town runs costs 1/(1\u002Bc) of its labor, where c is the share of the crew in post times the share of their power hours the ledger has left (so x2 output per worker at full power). A working factory adds soot to its tile and the ring around it (up to 10 a tile, fading a tenth each season); each point of soot on a town\u0027s own tile adds a fiftieth to its endemic deaths, up to a fifth (P, docs/MVP/38 \u00A75.7)."}],"era":6,"flavor":"Many hands, one engine, one roof.","id":"MEC-10","idx":294,"lineage":"MEC","moment":"A hundred looms clatter under a single drive shaft.","name":"Factory System","practice":[{"action":"factory_work","share":100}],"requires":["MEC-09","FIB-12","SOC-12"],"status":"numeric","theme":"craft","type":"I"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Lathes and mills cutting metal: factory output \u00D72; repairs \u221250% time."}],"era":7,"id":"MEC-11","idx":295,"lineage":"MEC","name":"Machine Tools \u0026 Interchangeable Parts","requires":["MEC-10","MET-14"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Mass production \u00D73; consumer goods abundant (\u002BCohesion via prosperity)."}],"era":8,"id":"MEC-12","idx":296,"lineage":"MEC","name":"Assembly Line","requires":["MEC-11","NRG-09"],"status":"draft","theme":"craft","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Build: Computing center. \u002BInsight (Researcher output \u00D71.5); planners optimize logistics. *KEY-9 prerequisite.*"}],"era":8,"id":"MEC-13","idx":297,"lineage":"MEC","name":"Electronic Computer","requires":["MEC-12","NUM-13"],"status":"draft","theme":"craft","type":"D"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Microchips: every electronic-age project\u0027s effect \u002B25%."}],"era":9,"id":"MEC-14","idx":298,"lineage":"MEC","na