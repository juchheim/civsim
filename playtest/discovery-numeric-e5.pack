ol garment","order":50,"outputs":{"G-WOOLGARMENT":1},"practice":"fiber","unlocked_by":["HUS-06"]}],"roles":[{"id":"administrator","insight":0,"name":"Administrator","staffing":"1 per capital or census office; must be staffed","unlocked_by":"GOV-07"},{"id":"attendant","insight":0,"name":"Attendant","staffing":"2 per staffed hospital","unlocked_by":"MED-07"},{"id":"baker","insight":0,"name":"Baker","staffing":"1 per bakery","unlocked_by":"FOD-08"},{"id":"botanist","insight":2,"name":"Botanist","staffing":"1 per botanical garden","unlocked_by":"FOR-09"},{"id":"chief","insight":0,"name":"Chief","unlocked_by":"GOV-02"},{"id":"collier","insight":0,"name":"Collier","staffing":"1 per settlement burning charcoal","unlocked_by":"FIR-08"},{"id":"elder","insight":8,"name":"Elder","unlocked_by":"GOV-01"},{"id":"engineer","insight":0,"name":"Engineer","staffing":"2 per atmospheric engine; adults taken off other work","unlocked_by":"NRG-06"},{"id":"envoy","insight":0,"name":"Envoy","staffing":"1 per civilization, at the capital","unlocked_by":"DIP-04"},{"id":"governor","insight":0,"name":"Governor","staffing":"1 per connected province seat","unlocked_by":"TER-08"},{"id":"gunner","insight":0,"name":"Gunner","staffing":"4 crew per cannon","unlocked_by":"WAR-12"},{"id":"king","insight":0,"name":"King","staffing":"1 at the capital","unlocked_by":"GOV-05"},{"id":"knight","insight":0,"name":"Knight","staffing":"a soldier with a horse and steel arms; at most a quarter of soldier slots","unlocked_by":"WAR-10"},{"id":"master_mason","insight":0,"name":"Master mason","staffing":"1 per large stone work; required for the Gothic Cathedral","unlocked_by":"STN-13"},{"id":"midwife","insight":0,"name":"Midwife","unlocked_by":"MED-03"},{"id":"miner","insight":0,"name":"Miner","staffing":"every worker on a mine job","unlocked_by":"MIN-04"},{"id":"missionary","insight":0,"name":"Missionary","staffing":"1 per active faith route or mission","unlocked_by":"BEL-09"},{"id":"monk","insight":4,"name":"Monk","staffing":"4 per monastery; adults taken off other work; 16 Insight/year when all four are staffed","unlocked_by":"BEL-10"},{"id":"navigator","insight":0,"name":"Navigator","staffing":"1 per ocean-going ship carrying a chronometer","unlocked_by":"WAY-10"},{"id":"physician","insight":0,"name":"Physician","staffing":"1 per staffed hospital","unlocked_by":"MED-05"},{"id":"potter","insight":0,"name":"Potter","staffing":"1 per potter\u0027s workshop","unlocked_by":"CER-04"},{"id":"priest","insight":16,"name":"Priest","staffing":"1 per temple","unlocked_by":"BEL-06"},{"id":"researcher","insight":120,"name":"Researcher","unlocked_by":"LRN-12"},{"id":"scholar","insight":48,"name":"Scholar","unlocked_by":"LRN-05"},{"id":"scribe","insight":24,"name":"Scribe","staffing":"1 at the capital; 2 per school","unlocked_by":"COM-05"},{"id":"shaman","insight":12,"name":"Shaman","unlocked_by":"BEL-03"},{"id":"smith","insight":0,"name":"Smith","staffing":"1 per forge","unlocked_by":"MET-02"},{"id":"soldier","insight":0,"name":"Soldier","staffing":"ordinary slots floor(0.10 \u00D7 adults); 20% after WAR-08; supplied and trained","unlocked_by":"WAR-07"},{"id":"trader","insight":0,"name":"Trader","staffing":"1 per market","unlocked_by":"TRD-04"},{"id":"warrior","insight":0,"name":"Warrior","unlocked_by":"WAR-04"},{"id":"watcher","insight":0,"name":"Watcher","unlocked_by":"DEF-02"}],"structures":[{"class":"structure","effect":"May staff one Scholar; cap 1 per academy; does not create a Scholar","id":"academy","labor":16,"materials":"G-BLOCK 8, G-WOOD 2","name":"Academy","unlocked_by":"LRN-05"},{"class":"structure","effect":"Raises water-limited effective city cap by 40%; disease term \u00D70.85 in served city; no food or housing creation","id":"aqueduct","labor":40,"materials":"G-BLOCK 20, G-ASHLAR 8, G-WOOD 5","name":"Aqueduct","unlocked_by":"BLD-10"},{"class":"structure","effect":"One per civilization; the player may build it in any Town of 60 or more with a forge and reachable stone. Casts cannons after MET-12 and mills powder after CHM-07; connected own towns relay construction stone, iron and powder ores over land (8-tile links, extended by transport research), with long hauls wearing carts. The planner prefers a stone-supplied, defended forge town near owned frontiers. Replaces the powder mill (docs/MVP/37)","id":"arsenal","labor":100,"materials":"G-BLOCK 12, G-ASHLAR 24, G-WOOD 12, G-IRON 4","name":"Arsenal","unlocked_by":"WAR-12"},{"class":"structure","effect":"Staffed by two engineers: supplies 10 power units on 1 L coal per unit-season (P, e6_power_oracle) in the shared power ledger and pumps a flooded coal mine; idle without coal or staff","id":"atmospheric_engine","labor":36,"materials":"G-CAST 4, G-BLOCK 8, G-WOOD 6","name":"Atmospheric engine","unlocked_by":"NRG-06"},{"class":"structure","effect":"Town or City; grain food value \u002B20% for 40 people; one Baker","id":"bakery","labor":4,"materials":"clay 4 L, stone 4 L","name":"Bakery","unlocked_by":"FOD-08","upkeep":"wood 2 L/season"},{"class":"structure","effect":"Garrisoned star fort: storm multiplier 1.5 as an alternative to the concentric step; counts as a wall of about 6.75 to 9.0 on the integrity track; halves the gunpowder wall penalty; crews against it suffer 25% more attrition","id":"bastion_fort","labor":70,"materials":"G-BLOCK 40, G-FBRICK 20","name":"Bastion fort","unlocked_by":"DEF-10"},{"class":"structure","effect":"Staffed and maintained city sanitation; density disease pressure \u00D70.75","id":"bathhouse","labor":20,"materials":"G-BLOCK 8, G-WOOD 4","name":"Bathhouse / latrines","unlocked_by":"MED-06"},{"class":"structure","effect":"In a smelting town with a forge and a mill: each bloomery batch yields x4 iron from x4 ore and x2 charcoal and x2 labor (half the charcoal and labor per litre); no coal before E6","id":"blast_furnace","labor":40,"materials":"G-BLOCK 24, G-WOOD 6","name":"Blast furnace","unlocked_by":"MET-12"},{"class":"structure","effect":"Staffed by a botanist: medical effects \u002B15% in the settlement; trials imported crops; an empty garden has no effect","id":"botanical_garden","labor":20,"materials":"G-WOOD 4, G-STONE 6","name":"Botanical garden","unlocked_by":"FOR-09"},{"class":"structure","effect":"Maintains road continuity across river at crossing; no transport-capacity multiplier","id":"bridge","labor":16,"materials":"G-BLOCK 6, G-ASHLAR 2, G-WOOD 2","name":"Bridge","unlocked_by":"TRN-08"},{"class":"structure","effect":"Irrigated field: yield \u00D71.5 (\u00D72 on Arid and Desert, soil counts 100); flood loss \u00D70.5","id":"canal","labor_note":"1.0 per field tile within 2 of a river","materials":"\u2014","name":"Canal","unlocked_by":"AGR-06","upkeep":"0.1 ws/tile/yr"},{"class":"structure","effect":"Town or City on 2 or more routes: food cap \u002B25%; route capacity \u00D72 through it","id":"caravanserai","labor":8,"materials":"wood 6 L, stone 6 L","name":"Caravanserai","unlocked_by":"TRD-05","upkeep":"\u2014"},{"class":"structure","effect":"Strongpoint and claim anchor, radius 5 subject to existing claim rules; garrison required","id":"castle","labor":60,"materials":"G-ASHLAR 20, G-WOOD 12, G-IRON 2","name":"Castle","unlocked_by":"DEF-08"},{"class":"structure","effect":"Scheduled work \u002B5% and a small Cohesion gain within 6 tiles; no global multiplier","id":"clock_tower","labor":30,"materials":"G-BLOCK 10, G-IRON 1, G-WOOD 4","name":"Clock tower","unlocked_by":"MEC-08"},{"class":"structure","effect":"On a seen coal tile: staffed miners dig G-COAL from seams 2 to 3 deep; a deep seam floods without an atmospheric engine","id":"coal_mine","labor":30,"materials":"G-WOOD 8, G-STONE 4","name":"Coal mine","unlocked_by":"MIN-09"},{"class":"structure","effect":"Recipe make_coke: 1.5 coal to 1 coke in a kiln; with an oven 1.2 coal to 1 coke in half the labor (P, docs/MVP/38 \u00A75.1). Wanted where a furnace smelts on coke","id":"coke_oven","labor":20,"materials":"G-FBRICK 12, G-CLAY 4","name":"Coke oven","unlocked_by":"FIR-12"},{"class":"structure","effect":"Upgrade of a castle; defense multiplier fitted below the 1.9 storm crossover; requires a garrison","id":"concentric_castle","labor":80,"materials":"G-ASHLAR 24, G-WOOD 12, G-IRON 2","name":"Concentric castle","unlocked_by":"DEF-09"},{"class":"structure","effect":"Large-structure and Wonder eligible construction labor \u00D70.5 at settlements with crane","id":"crane","labor":16,"materials":"G-WOOD 8, G-IRON 2","name":"Crane","unlocked_by":"MEC-06"},{"class":"structure","effect":"Enables smoking/drying at this camp","id":"drying_rack","labor":{"$fix":858993459},"materials":"wood 0.5 L","name":"Drying rack","unlocked_by":"FOD-02","upkeep":"\u2014"},{"class":"structure","effect":"Staffed by traders in a harbor settlement: spreads voyage and disaster losses across the realm; creates no money","id":"exchange_house","labor":30,"materials":"G-BLOCK 14, G-WOOD 6","name":"Exchange house","unlocked_by":"TRD-11"},{"class":"structure","effect":"Staffed and powered: craft output per worker x2 scaled by the power it receives; draws workers from the countryside; soots adjacent tiles (local pollution)","id":"factory","labor":50,"materials":"G-BLOCK 20, G-WOOD 10, G-CAST 4","name":"Factory","unlocked_by":"MEC-10"},{"class":"structure","effect":"\u00A74.4","id":"field","labor_note":"clearing (\u00A74.4.1)","materials":"\u2014","name":"Field","unlocked_by":"AGR-01","upkeep":"yearly labor"},{"class":"structure","effect":"Casting: tool kits, arms, fine bronze, chariot fittings; one Smith","id":"forge","labor":2,"materials":"stone 2 L, clay 2 L","name":"Forge","unlocked_by":"MET-03","upkeep":"\u2014"},{"class":"structure","effect":"Adjacent crossing only: border flip pressure \u00D70.5 and raid success \u00D70.3 where crossing uses built segment","id":"frontier_wall_segment","labor":12,"materials":"G-BLOCK 4, G-WOOD 2 per segment","name":"Frontier wall segment","unlocked_by":"DEF-07"},{"class":"structure","effect":"Built on wall; intact wal