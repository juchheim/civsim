 (P)","op":"mult","stat":"elder_hazard","value":{"$fix":4080218931}},{"kind":"rule","text":"A hospital works only with a physician and 2 attendants (P); an empty hospital has no effect."}],"era":5,"flavor":"The sick are brought to a house for them.","id":"MED-07","idx":307,"lineage":"MED","moment":"Sisters tend rows of beds in a long ward.","name":"Hospitals","practice":[{"action":"heal","share":100}],"requires":["MED-06","BEL-09"],"status":"numeric","theme":"kin","type":"S"},{"cost":{"$fix":41231686041600},"effects":[{"kind":"mod","note":"imported outbreaks only, about half of all outbreaks","op":"mult","stat":"outbreak_roll","value":{"$fix":3221225472}},{"kind":"mod","note":"between settlements linked by route or shared border","op":"mult","stat":"epidemic_spread","value":{"$fix":2147483648}}],"era":5,"flavor":"Ships wait forty days before the gate opens.","id":"MED-08","idx":308,"lineage":"MED","moment":"A harbor chain holds a plague ship offshore.","name":"Quarantine","practice":[{"action":"heal","share":100}],"requires":["MED-07","GOV-10"],"status":"numeric","theme":"kin","type":"I"},{"cost":{"$fix":51539607552000},"effects":[{"kind":"mod","note":"a hospital with a physician (P)","op":"mult","stat":"surgery_success","value":{"$fix":5583457484}},{"kind":"mod","op":"mult","stat":"medical_training_speed","value":{"$fix":8589934592}}],"era":6,"flavor":"To cure the body, first learn how it is made.","id":"MED-09","idx":309,"lineage":"MED","moment":"A surgeon explains a drawn heart to students around a table.","name":"Anatomy","practice":[{"action":"heal","share":100}],"requires":["MED-08","LRN-08"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Smallpox-type epidemics \u221280%."}],"era":7,"id":"MED-10","idx":310,"lineage":"MED","name":"Inoculation \u0026 Vaccination","requires":["MED-09","LRN-09"],"status":"draft","theme":"kin","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose"