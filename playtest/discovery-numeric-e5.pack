0941132800},"effects":[{"kind":"admin","overreach":{"$fix":858993459}},{"kind":"adopt","mult":2}],"era":4,"flavor":"A message arrives before a traveler.","id":"COM-08","idx":100,"lineage":"COM","moment":"A courier changes horses at a road station.","name":"Courier Relays","practice":[{"action":"scribe","share":100}],"requires":["COM-07","TRN-07"],"status":"numeric","theme":"reach","type":"I"},{"cost":{"$fix":27487790694400},"effects":[{"id":"G-PAPER","kind":"good"},{"kind":"mod","note":"scribes and scholars only (writing roles)","op":"mult","stat":"writing_role_output","value":{"$fix":5583457484}}],"era":5,"flavor":"A page costs a rag, not a flock.","id":"COM-09","idx":101,"lineage":"COM","moment":"A sheet is lifted wet from a vat and hung to dry.","name":"Paper","practice":[{"action":"scribe","share":100}],"requires":["COM-08","FIB-07"],"status":"numeric","theme":"reach","type":"M"},{"cost":{"$fix":27487790694400},"effects":[{"kind":"build","structure":"print_shop"},{"id":"G-BOOK","kind":"good"},{"kind":"mod","note":"Commons Insight only","op":"mult","stat":"commons_insight","value":{"$fix":4939212390}},{"kind":"mod","note":"contribution only, capped at the existing 0.5 cost floor","op":"mult","stat":"diffusion_discount","value":{"$fix":6442450944}},{"kind":"rule","text":"KEY-6 prerequisite."}],"era":5,"flavor":"Letters are cast once and set a thousand times.","id":"COM-10","idx":102,"lineage":"COM","moment":"A press descends and a page comes away black and sharp.","name":"Movable Type","practice":[{"action":"scribe","share":100}],"requires":["COM-09","MEC-05","MET-06"],"status":"numeric","theme":"reach","type":"D"},{"cost":{"$fix":51539607552000},"effects":[{"id":"G-PAMPHLET","kind":"good"},{"kind":"mod","note":"events reach Cohesion faster when news travels in print (P)","op":"mult","stat":"cohesion_event_response","value":{"$fix":6442450944}},{"kind":"mod","note":"public opinion: GOV effects \u002B10% in settlements with a print shop (P)","op":"mult","stat":"gov_effects","value":{"$fix":4724464025}}],"era":6,"flavor":"By nightfall the whole town knows.","id":"COM-11","idx":103,"lineage":"COM","moment":"A boy runs from the print shop with wet sheets under his arm.","name":"Newspapers \u0026 Pamphlets","practice":[{"action":"scribe","share":100}],"requires":["COM-10"],"status":"numeric","theme":"reach","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"Build: Telegraph lines. Instant messages between settlements: Overreach \u221240%; coordination of rail and armies. *KEY-8 prerequisite.*"}],"era":7,"id":"COM-12","idx":104,"lineage":"COM","name":"Telegraph","requires":["COM-11","INQ-11"],"status":"draft","theme":"reach","type":"D"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Voice at distance: business and admin efficiency \u002B15%."}],"era":8,"id":"COM-13","idx":105,"lineage":"COM","name":"Telephone","requires":["COM-12","NRG-09"],"status":"draft","theme":"reach","type":"D"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Broadcast: national Cohesion \u002B; soft power reaches abroad."}],"era":8,"id":"COM-14","idx":106,"lineage":"COM","name":"Radio","requires":["COM-13","INQ-15"],"status":"draft","theme":"reach","type":"D"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"Mass culture at home: Cohesion \u002B10%; soft power \u00D71.5."}],"era":8,"id":"COM-15","idx":107,"lineage":"COM","name":"Television","requires":["COM-14","ART-12"],"status":"draft","theme":"reach","type":"D"},{"cost":{"$fix":46385646795000000},"effects":[{"kind":"prose","text":"Build: Data center and backbone. Data links glow between cities: Insight \u002B25%, adoption instant in connected areas. *KEY-10 prerequisite.*"}],"era":9,"id":"COM-16","idx":108,"lineage":"COM","name":"Internet","requires":["COM-15","MEC-15","CER-15"],"status":"draft","theme":"reach","type":"S"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Everyone connected: rural settlements gain urban Insight rates."}],"era":9,"id":"COM-17","idx":109,"lineage":"COM","name":"Mobile Networks","requires":["COM-16","NRG-15"],"status":"draft","theme":"reach","type":"M"},{"cost":{"$fix":57982058496000000},"effects":[{"kind":"prose","text":"Viral culture: soft power \u00D71.5; Cohesion volatility (random swings \u00B1)."}],"era":9,"id":"COM-18","idx":110,"lineage":"COM","name":"Social Media","requires":["COM-17","ART-14"],"status":"draft","theme":"reach","type":"I"},{"cost":{"$fix":113387136610},"effects":[{"kind":"build","structure":"thorn_barrier"},{"cause":"predators","kind":"hazard","mult":{"$fix":3435973836}},{"kind":"mod","note":"Raiders entering camp, speed \u00D70.5","op":"mult","stat":"raiders_entering_camp_speed","value":{"$fix":2147483648}}],"era":0,"flavor":"Let the night beasts go hungry.","id":"DEF-01","idx":111,"lineage":"DEF","moment":"A ring of thorny branches pulled around the sleeping camp","name":"Thorn Barriers","practice":[{"action":"build","share":100}],"requires":["WOD-01"],"status":"numeric","theme":"reach","type":"S"},{"cost":{"$fix":171798691800},"effects":[{"id":"watcher","kind":"role"},{"kind":"build","note":"sight \u002B3","structure":"lookout_post"},{"kind":"mod","note":"Raid surprise, \u221270%","op":"pct","stat":"raid_surprise","value":{"$fix":-3006477107}}],"era":1,"flavor":"Eyes that never sleep.","id":"DEF-02","idx":112,"lineage":"DEF","moment":"A watcher on a rock shouts a warning","name":"Lookouts","practice":[{"action":"guard","share":100}],"requires":["DEF-01","COM-02"],"status":"numeric","theme":"reach","type":"R"},{"cost":{"$fix":773094113250},"effects":[{"kind":"build","note":"settlement defense \u00D72","structure":"palisade"}],"era":2,"flavor":"A wall of trees.","id":"DEF-03","idx":113,"lineage":"DEF","moment":"Sharpened stakes ring a village","name":"Palisades \u0026 Ditches","practice":[{"action":"build","share":50},{"action":"guard","share":50}],"requires":["DEF-02","WOD-03"],"status":"numeric",