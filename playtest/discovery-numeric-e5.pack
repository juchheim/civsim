rce":"22 \u00A77.5","unit":"figures","value":4},{"id":"RaidPartyShareMin","source":"22 \u00A77.5","unit":"\u00D7 adults","value":{"$fix":644245094}},{"id":"RaidPartyShareMax","source":"22 \u00A77.5","unit":"\u00D7 adults","value":{"$fix":1288490188}},{"id":"BarterGain","source":"13 \u00A74.2","unit":"share (0.05 with NUM-04)","value":{"$fix":429496729}},{"id":"ScarcityClampLow","source":"13 \u00A74.2","unit":"\u00D7","value":{"$fix":2147483648}},{"id":"ScarcityClampHigh","source":"13 \u00A74.2","unit":"\u00D7","value":3},{"id":"CompactHorizonSeasons","source":"22 \u00A76.2","unit":"seasons","value":4},{"id":"CompactMinRelations","source":"22 \u00A76.2","unit":"Relations (\u221230 with DIP-05)","value":0},{"id":"EmbargoRelations","source":"22 \u00A74.3","unit":"Relations","value":-10},{"id":"InviteSeasons","source":"22 \u00A74.3","unit":"seasons","value":8},{"id":"InviteRelations","source":"22 \u00A74.3","unit":"Relations","value":30},{"id":"InviteGift","source":"22 \u00A74.3","unit":"value","value":10},{"id":"CaravanRaidRelations","source":"22 \u00A76.3","unit":"Relations","value":-30},{"id":"CaravanRaidReputation","source":"22 \u00A76.3","unit":"reputation","value":-10},{"id":"CaravanEscort","source":"22 \u00A76.3","unit":"warriors","value":2},{"id":"PactYears","source":"22 \u00A712 (DIP-04, DIP-05)","unit":"years","value":8},{"id":"PactBreakRelations","source":"22 \u00A712 (DIP-04, DIP-05)","unit":"Relations","value":-60},{"id":"PactBreakReputation","source":"22 \u00A712 (DIP-04, DIP-05)","unit":"reputation","value":-30},{"id":"TreatyYears","source":"22 \u00A712 (DIP-04, DIP-05)","unit":"years","value":10},{"id":"TinFolkAdults","source":"22 \u00A76.4","unit":"people","value":9},{"id":"TinFolkElders","source":"22 \u00A76.4","unit":"people","value":2},{"id":"TinFolkChildren","source":"22 \u00A76.4","unit":"people","value":13},{"id":"TinFolkRadius","source":"22 \u00A76.4, \u00A711","unit":"tiles","value":3},{"id":"TinFolkMinDist","source":"22 \u00A76.4, \u00A711","unit":"tiles","value":8},{"id":"FreeFolkDefense","source":"22 \u00A76.4, \u00A711","unit":"\u00D7","value":{"$fix":3435973836}},{"id":"TinFolkRaidReputation","source":"22 \u00A76.4","unit":"reputation","value":-5},{"id":"TinFolkCaptureReputation","source":"22 \u00A76.4","unit":"reputation","value":-10},{"id":"TinFolkTraderRelations","source":"22 \u00A76.4","unit":"Relations","value":-20},{"id":"PlagueR0","source":"22 \u00A710, 09 \u00A710","unit":"R0","value":{"$fix":8589934592}},{"id":"PlagueCFR","source":"22 \u00A710, 09 \u00A710","unit":"share","value":{"$fix":1503238553}},{"id":"PoxEndemicPop","source":"22 \u00A710","unit":"people in one settlement","value":1000},{"id":"CivicLaborShare","source":"07d WP7: civic construction (canals, Market, Temple, Palace, School, Bakery, Hall, Ziggurat) takes at most this share of a settlement\u0027s work, as the metal build of WP6","unit":"share of labor","value":{"$fix":429496729}},{"id":"FoodShareCapOutsideHunger","source":"docs/MVP/28 production-gap diagnosis: from the Bronze Age on, food work takes at most this share of a settlement\u0027s plannable labor unless food security is below 0.9; before the cap food took 70-85% in every settlement and construction, materials and civic works got 2-3% of the labor (4-seed Iron matches: Iron building types built 23% -\u003E 27% alone)","unit":"share of labor","value":{"$fix":2791728742}},{"id":"IronBuildLaborShare","source":"docs/MVP/28 \u00A75: the most of a settlement\u0027s work the one Iron structure under construction (and its stone) may take in a season; was 0.10. Four-seed Iron matches: Iron types built 24% at 0.10, 32% at 0.20, 0.30 and 0.40 (no further gain), people and structures unchanged","unit":"share of labor","value":{"$fix":858993459}},{"id":"StoneWallsCutStonePerRing","source":"docs/MVP/28 \u00A74: stone raised per Village ring (a Town ring 2x, a City ring 3x), quarried from the 8 tiles around the settlement and dressed on site; was 60 L of dressed ashlar (22 \u00A77), which the craft step never produced and a range holds only about 74 L of. At 20 L/15 ws rings go up in 6-18 per civilization in the 4-seed Iron matches (none before)","unit":"L stone","value":20},{"id":"StoneWallsLaborPerRing","source":"docs/MVP/28 \u00A74: build labor per Village ring (a Town ring 2x, a City ring 3x), including quarrying, hauling and dressing the stone; was 30 ws (22 \u00A77)","unit":"work-seasons","value":15},{"id":"CityTempleLaborMultiplier","source":"07d F4 B17 tuning: the selected City-site Temple gets 50% more civic labor when food security is at least 0.8 and housing already supports City population; no global research or housing-cap change","unit":"\u00D7 civic share","value":{"$fix":6442450944}},{"id":"MarketEvery","source":"07d \u00A73 (balance_sim live MarketEvery): a Market in the largest settlement, one more per 4 settlements","unit":"settlements","value":4},{"id":"EpidemicInflowE3","source":"07d B10 sensitivity: E3 uses the typical E4 inflow from 09 \u00A710.1; 24-seed expected baseline epidemic share is 7.1% (inside B10\u0027s 7\u201313% band); realized deaths are diagnostic; routes add to it (WP8)","unit":"share","value":{"$fix":1288490188}},{"id":"HearthPeople","source":"metal_sim.py hearth_per (10 \u00A75): one hearth, 1.5 L a season and 3 in Winter, per 35 people","unit":"people per hearth","value":35},{"id":"KilnWoodPerPerson","source":"metal_sim.py kiln_wood (10 \u00A75: pottery and lime firing)","unit":"L/person/yr","value":{"$fix":858993459}},{"id":"BuildWoodPerPerson","source":"metal_sim.py build_wood is 0.15 for dwellings, stores and repairs; the live planner already fells the timber of every dwelling and store it builds, so only repairs (a third) are added here (07d WP7)","unit":"L/person/yr","value":{"$fix":214748364}},{"id":"DeadwoodPerTile","source":"10 \u00A75.1, 23 \u00A77.4: deadwood feeds hearths and kilns, never charcoal","unit":"L/forest tile/yr","value":2}],"type_mult":{"D":1,"I":{"$fix":6442450944},"K":{"$fix":10737418240},"M":1,"R":{"$fix":3435973836},"S":{"$fix":5153960755},"W":2}},"format":"civsim-content-pack","ladders":{"chop":[{"mult":{"$fix":6442450944},"name":"Pebble chopper","project":"STN-01","rung":1},{"mult":{"$fix":8589934592},"name":"Hand axe","project":"STN-02","rung":2},{"mult":{"$fix":12884901888},"name":"Hafted axe","project":"STN-04","rung":3},{"mult":{"$fix":17179869184},"name":"Polished axe","project":"STN-08","rung":4},{"mult":{"$fix":19327352832},"name":"Copper axe","project":"MET-03","rung":5},{"mult":{"$fix":25769803776},"name":"Bronze axe","project":"MET-04","rung":6},{"mult":{"$fix":25769803776},"name":"Bronze axe","project":"MET-05","rung":6},{"mult":{"$fix":38654705664},"name":"iron_axe","project":"MET-09","rung":7}],"clear":[{"mult":{"$fix":4294967296},"name":"Slash-and-burn","project":"AGR-04","rung":1}],"farm":[{"name":"Cultivation","project":"AGR-01","rate":{"$fix":17179869184},"rung":1,"unit":"R/tile/yr"},{"name":"Domesticated staple by biome","project":"AGR-02","rate":{"$fix":34359738368},"rung":2,"unit":"R/tile/yr"},{"name":"Ard plough","project":"AGR-05","rate":{"$fix":34359738368},"rung":3,"unit":"R/tile/yr"},{"mult":{"$fix":8589934592},"name":"iron_scythe","project":"AGR-09","rung":4}],"fish":[{"name":"Harpoon","project":"HNT-07","rate":{"$fix":6871947673},"rung":1,"unit":"R/ws"},{"name":"Hooks","project":"HNT-08","rate":{"$fix":13743895347},"rung":2,"unit":"R/ws"}],"forage":[{"mult":{"$fix":6442450944},"name":"Digging stick","project":"WOD-01","rung":1},{"mult":{"$fix":6442450944},"name":"Baskets","project":"FIB-05","rung":2},{"mult":{"$fix":10307921510},"name":"Wild-grass sickle","project":"FOR-04","rung":3},{"mult":{"$fix":10307921510},"name":"Tended stands","project":"FOR-06","rung":4}],"haul":[{"mult":{"$fix":21474836480},"name":"Ox cart","project":"TRN-05","rung":1}],"herd":[{"mult":{"$fix":8589934592},"name":"Herd following","project":"HUS-02","rung":0}],"hunt":[{"name":"Wooden spear","project":"HNT-02","rate":{"$fix":6871947673},"rung":1,"unit":"R/ws"},{"name":"Stone-tipped spear","project":"HNT-03","rate":{"$fix":9448928051},"rung":2,"unit":"R/ws"},{"name":"Cooperative drive","project":"HNT-04","rate":{"$fix":13743895347},"rung":3,"unit":"R/ws"},{"name":"Spear-thrower","project":"HNT-05","rate":{"$fix":12025908428},"rung":4,"unit":"R/ws"},{"name":"Bow","project":"HNT-06","rate":{"$fix":12884901888},"rung":5,"unit":"R/ws"}],"mine":[{"mult":{"$fix":6442450944},"name":"Shaft","project":"MIN-04","rung":1},{"mult":{"$fix":9663676416},"name":"Fire-setting","project":"MIN-05","rung":2}],"paddle":[{"mult":{"$fix":8589934592},"name":"Canoe","project":"SEA-02","rung":1},{"mult":{"$fix":8589934592},"name":"Dugout","project":"SEA-03","rung":2},{"mult":{"$fix":10737418240},"name":"Outrigger","project":"SEA-04","rung":3},{"mult":{"$fix":10737418240},"name":"Plank boat","project":"SEA-05","rung":4},{"mult":{"$fix":21474836480},"name":"Square sail","project":"SEA-06","rung":5}],"pottery":[{"mult":{"$fix":12884901888},"name":"Potter\u0027s wheel","project":"CER-04","rung":1}],"scavenge":[{"mult":{"$fix":6442450944},"name":"Power scavenging","project":"HNT-01","rung":1}],"shape_timber":[{"mult":{"$fix":4294967296},"name":"Adze","project":"WOD-03","rung":1}],"till":[{"mult":{"$fix":4294967296},"name":"mouldboard","project":"AGR-10","rung":1}]},"lineages":[{"anchors":"cultivation (~11.5 ka, Fertile Crescent; independently in China, Mesoamerica, Andes, New Guinea, Sahel); legumes; slash-and-burn; ard (~4000 BCE); irrigation (Mesopotamia); manuring; terracing; iron sickles; heavy mouldboard plough (Roman/medieval); three-field system (~800 CE); Norfolk rotation (18th c.); seed drill (Tull 1701); reaper (1831); tractors (1890s\u20131920s); Green Revolution (1950s\u201360s); precision ag (1990s\u002B); GM crops (1994\u002B).","code":"AGR","name":"Agriculture","purpose":"the great food multiplier. It anchors people to land, makes settlements permanent and fuels population growth. Hosts the Till and Harvest ladders.","theme":"kin"},{"anchors":"shell beads (Blombos ~75 ka); storytelling; cave art (Sulawesi ~51 ka; Chauvet ~36 ka); bone flutes (~40 ka); songlines; reliefs; epics (Gilgamesh); theatre (Athens); illuminated manuscripts; Renaissance patronage; public museums (1683\u002B) and concerts; photography (1839) and cinema (1895); radio and TV; global pop culture; video games (1970s\u002B).","code":"ART","name":"Arts \u0026 Culture","purpose":"Cohesion, soft claims (cultural influence beyond borders), the Beacon lever, Know-how sharing and Legends. In the post-modern era, culture becomes a primary means of influence (soft power).","theme":"kin"},{"anchors":"burial (Qafzeh ~100 ka; Shanidar); animism and totemism; shamanism; ancestor cults (plastered skulls, Jericho); sacred sites (G\u00F6bekli Tepe ~9500 BCE); temples and priesthoods; state cults; Axial Age philosophy (~800\u2013200 BCE); universal religions; monasticism; pilgrimage; Reformation (1517); humanism and the Enlightenment; Universal Declaration of Human Rights (1948); pluralism.","code":"BEL","name":"Belief \u0026 Ritual","purpose":"Cohesion, morale under hardship, and sacred claims on land. Myth is the social technology that lets strangers cooperate at scale. No magic: belief works through people.","theme":"kin"},{"anchors":"lean-tos (Paleolithic); pit houses (Ohalo II ~23 ka); wattle and daub, mudbrick, longhouses (Neolithic); ziggurats; Roman arch, concrete and aqueducts; Gothic cathedrals; Renaissance; reinforced concrete (1860s); skyscrapers (1885); green building (1990s\u002B).","code":"BLD","name":"Building \u0026 Architecture","purpose":"shelter, housing capacity, public buildings and wonders. Housing is one of the three hard caps on population (with food and cohesion).","theme":"craft"},{"anchors":"Doln\u00ED V\u011Bstonice figurines ~26 ka; Xianrendong pottery ~20\u201319 ka; potter\u0027s wheel ~3500 BCE; glass ~2500\u20131500 BCE; glassblowing ~50 BCE; spectacles ~1290; achromatic lenses 18th c.; Czochralski silicon ~1950; optical fiber 1970.","code":"CER","name":"Ceramics \u0026 Glass","purpose":"containers, storage, building materials and optics. Pottery revolutionizes food storage; glass eventually lets people see the very small and the very far.","theme":"craft"},{"anchors":"ochre pigment (Blombos ~100\u201375 ka); birch tar (~200 ka, Neanderthal); lime plaster (~12 ka); natron and soap (Babylon ~2800 BCE); distillation (alchemy); gunpowder (China ~9th c.); Leblanc soda (1791); Portland cement (1824); coal-tar dyes (1856); dynamite (1867); Haber\u2013Bosch (1913); plastics (Bakelite 1907; post-war boom); green chemistry (1990s); nanomaterials (2000s).","code":"CHM","name":"Chemistry \u0026 Materials","purpose":"transforming substances: pigments, glues, lime, soap, gunpowder, acids, cement, explosives, fertilizer, plastics. Supplies inputs to nearly every other lineage.","theme":"craft"},{"anchors":"calls and gestures; spoken language; symbols (Blombos engravings ~75 ka); signal fires and drums; writing (Uruk ~3200 BCE; Egypt; China; Mesoamerica); papyrus and parchment; alphabet (~1800 BCE); Persian and Roman relays; paper (China ~105 CE); movable type (Bi Sheng ~1040; Gutenberg ~1450); newspapers (1605); telegraph (1837\u201344); telephone (1876); radio (1895); TV (1920s\u201350s); Internet (ARPANET 1969; Web 1991); mobile phones; social media (2000s).","code":"COM","name":"Language, Writing \u0026 Communication","purpose":"coordination, record-keeping and information speed. Communication speeds adoption, reduces Overreach, and is the backbone of the Information era.","theme":"reach"},{"anchors":"thorn zarebas; lookouts; palisades and ditches; hillforts; Jericho\u0027s walls (~8000 BCE) and Uruk; towers and gatehouses; Hadrian\u0027s Wall and the *limes*; castles (10th c.\u002B); concentric castles; *trace italienne* (16th c.); coastal batteries; trenches (1914); radar (1930s); nuclear deterrence (1950s\u002B); cyber defense (2000s\u002B).","code":"DEF","name":"Defense \u0026 Fortification","purpose":"protecting people, stores and claims from raids, predators and conquest. Defense makes claims sticky.","theme":"reach"},{"anchors":"greeting rituals; hospitality norms; marriage alliances; envoys and oaths; Treaty of Kadesh (~1259 BCE); tributary systems; Delian League and confederacies; dynastic marriages; resident embassies (Renaissance Italy); Concert of Europe (1815); Geneva Conventions (1864\u002B); League of Nations and UN; arms control (1963\u002B); G20 and global forums; Paris Agreement (2015).","code":"DIP","name":"Contact \u0026 Diplomacy","purpose":"structured relations with rival civilizations: peaceful first contact, alliances, treaties, vassals and global institutions. Diplomacy lets a weaker civilization survive and lets everyone share diffusion.","theme":"reach"},{"anchors":"Abri du Maras cord ~41\u201352 ka; eyed needles ~40\u201320 ka; spindle whorls and looms (Neolithic); silk (China, ~3000 BCE); flying shuttle 1733; power loom 1785; nylon 1935.","code":"FIB","name":"Fiber, Hide \u0026 Textiles","purpose":"cordage, containers, clothing and cloth. Lets people survive cold, carry more, fish with nets, and trade cloth, the great commodity of history.","theme":"craft"},{"anchors":"fire use at Wonderwerk ~1 Ma; hearths at Gesher Benot Ya\u0027aqov ~800 ka; heat-treated silcrete ~72 ka; kilns (Neolithic); coke (1709); arc furnace (1900).","code":"FIR","name":"Fire \u0026 Heat","purpose":"warmth, safety, cooking and every high-temperature craft. Fire decides where people can survive and what they can transform.","theme":"craft"},{"anchors":"cooking (\u2265 ~800 ka); smoking and drying; storage pits (Natufian); boiling in pots; beer and bread (~13 ka Raqefet; ~14 ka Shubayqa flatbread); granaries (Dhra\u0027 ~11 ka); salting; ovens; the Roman *annona*; sugar refining; canning (Appert 1810); refrigeration (1870s\u002B); industrial processing; cold-chain logistics.","code":"FOD","name":"Food Craft \u0026 Storage","purpose":"getting more value from food and keeping it. Storage turns seasonal surplus into year-round security, which enables sedentism, specialists and cities.","theme":"kin"},{"anchors":"tuber digging; nut and seed gathering; Ohalo II wild cereals (~23 ka); Natufian sickles (~12 ka); orchards (olive, fig, date, ~6000 BCE); grafting (antiquity); botanical gardens (Padua 1545); Columbian Exchange (1492\u002B); Mendel (1866); seed banks (Svalbard 2008).","code":"FOR","name":"Foraging \u0026 Plant Lore","purpose":"the first food engine and the root of agriculture. Later, plant science.","theme":"kin"},{"anchors":"elder councils; chieftainship; customary law; tribute and redistribution (palace economies); kingship; Ur-Nammu (~2100 BCE) and Hammurabi (~1754 BCE); bureaucracy and census; Athenian democracy and Roman Republic; feudal contracts; canon and common law; Magna Carta and parliaments; Westphalian nation-state (1648); constitutions (1787\u002B); universal suffrage; e-government.","code":"GOV","name":"Governance \u0026 Law","purpose":"holding large, spread-out populations together; unlocking player levers (Posture); reducing Overreach; enabling taxation and administration.","theme":"kin"},{"anchors":"power scavenging; Sch\u00F6ningen spears (~300 ka); stone-tipped spears (~500\u2013300 ka); atlatl (~30\u201320 ka); bow (~70\u201364 ka; possibly ~80 ka); fishhooks (Sakitari ~23 ka); fish weirs; whaling; falconry; deep-sea fleets; steam trawlers (1880s); aquaculture; sonar and quotas.","code":"HNT","name":"Hunting \u0026 Fishing","purpose":"protein, hides and bone. Hunting dominates early food and skill (and feeds into WAR). Fishing makes coasts and rivers rich.","theme":"kin"},{"anchors":"dogs (\u2265 ~15 ka, possibly 30\u201340 ka; Goyet ~31.7 ka disputed); reindeer following; goats and sheep (~11\u201310 ka); cattle and pigs (~10.5 ka); dairying (~7000 BCE); wool sheep; horse (Botai ~3500 BCE; DOM2 ~2200 BCE); pastoral nomadism; camels (~1000 BCE); Bakewell\u0027s breeding (18th c.); fodder crops; vet schools (1761); refrigerated meat ships (1877\u20131882); feedlots; animal genomics.","code":"HUS","name":"Animal Husbandry","purpose":"walking food stores, draft power, wool, milk and the horse. Turns grasslands and hills into productive territory; enables nomadic expansion.","theme":"kin"},{"anchors":"tracking (an ancient \u0022science\u0022); sky watching; stone and ore lore; Ionian natural philosophy (~600 BCE); Archimedes; Ibn al-Haytham\u0027s optics and Peregrinus on magnetism; Galileo\u0027s telescope (1609) and Copernicus; scientific method (Bacon, Galileo, Royal Society); Newton (1687); Lavoisier (1789); Faraday and Maxwell; thermodynamics; Lyell and Darwin; genetics (1900 rediscovery); relativity and quantum theory (1905\u20131927); fission (1938); rocketry (1926\u201357); transistor (1947); ecology and climate science; molecular biology (1953\u002B).","code":"INQ","name":"Inquiry \u0026 Natural Science","purpose":"pushing the frontier. Reveals hidden resources (prospecting, geology), unlocks the scientific institutions that cut research costs, and provides the physics behind electricity, the atom, rockets and transistors.","theme":"reach"},{"anchors":"imitation learning; oral tradition; apprenticeship; scribal schools (edubba, Sumer); Plato\u0027s Academy and the Lyceum; Library of Alexandria; cathedral schools; universities (Bologna 1088); Royal Society (1660); public schooling (Prussia 1763; widespread 19th c.); mass education; industrial R\u0026D labs (Menlo Park 1876; Bell Labs 1925); open knowledge (Wikipedia 2001; MOOCs); AI-assisted research (2020s).","code":"LRN","name":"Learning \u0026 Education","purpose":"the Insight multiplier and adoption speed (how fast completed projects spread across the map). The research engine of the research game.","theme":"kin"},{"anchors":"levers and rollers (prehistoric); wheel (~3500 BCE); pulley and screw (Archimedes); treadwheel crane (Roman); crank and cam (medieval); mechanical clock (~1300); precision instruments (17th\u201318th c.); factory system (Arkwright, 1771); interchangeable parts (~1800\u20131850); assembly line (1913); ENIAC (1945); integrated circuit (1958); personal computer (1970s); industrial robots (1961\u002B).","code":"MEC","name":"Mechanics \u0026 Machines","purpose":"mechanical advantage and automation. Turns energy into work: cranes, mills, clocks, factories and computers. The late-game multiplier on Craft output and Insight.","theme":"craft"},{"anchors":"herbal medicine; bone setting (Shanidar); trepanation (~7000 BCE); Edwin Smith papyrus (~1600 BCE); Hippocrates and Galen; Roman baths and latrines; medieval hospitals; quarantine (Ragusa 1377); Vesalius (1543); inoculation and Jenner (1796); germ theory (Pasteur/Koch 1860s\u201380s); sewers (London 1860s); penicillin (1928/1940s); mass vaccination; genomics and imaging.","code":"MED","name":"Medicine \u0026 Health","purpose":"fewer deaths and longer lives. Elders produce double Insight, so lifespan *is* research. Medicine also defends against density disease, the natural brake on big cities.","theme":"kin"},{"anchors":"native copper (~8000 BCE); copper smelting (~5000 BCE); arsenical then tin bronze (~3000 BCE); bloomery iron (~1200 BCE); quench-hardened steel; wootz crucible steel; blast furnace (China ~5th c. BCE; Europe ~1300); coke smelting (1709); puddling (1784); Bessemer (1856); Hall\u2013H\u00E9roult aluminium (1886).","code":"MET","name":"Metallurgy","purpose":"the Bronze \u2192 Iron \u2192 Steel tool and weapon tiers, which are the biggest single multipliers on chopping, farming, building and fighting from E3 on. Geography-gated: copper, tin, arsenic and iron sit unevenly on the map, so trade or conquest matters.","theme":"craft"},{"anchors":"ochre mining (Lion Cave ~40 ka); flint mines (Grimes Graves ~2600 BCE); copper shafts (Timna); fire-setting; Archimedes\u0027 screw; Agricola\u0027s *De re metallica* (1556); steam pumping (1712); dynamite (1867); oil wells (1859); satellite prospecting (1972\u002B).","code":"MIN","name":"Mining \u0026 Quarrying","purpose":"access to stone, ores, salt, coal and oil. Mining turns the map\u0027s hidden deposits into usable stock. A depleting deposit is a reason to expand.","theme":"craft"},{"anchors":"draft cattle (~4000 BCE); yoke; water wheel (~3rd c. BCE); horse collar (China ~5th c.; Europe ~10th c.); windmill (Persia ~9th c.; Europe ~12th c.); Newcomen 1712; Watt 1769; dynamo 1860s; grid 1880s; ICE 1876; hydro (1880s\u002B); fission 1942/1954; PV 1954; wind turbines; Li-ion 1991.","code":"NRG","name":"Energy \u0026 Power","purpose":"the power source behind every action, from muscle to animals, water, wind, steam, electricity, oil, the atom and renewables. Energy is the hidden multiplier on almost every Craft ladder from E3 onward.","theme":"craft"},{"anchors":"tally bones (Lebombo ~43 ka; Ishango ~20 ka); lunar notation; clay tokens (~8000 BCE); standard weights; Babylonian place value; solar calendars; Egyptian and Greek geometry; zero and Hindu-Arabic numerals; al-Khwarizmi\u0027s algebra; Napier\u0027s logarithms (1614) and Descartes; calculus (1660s\u201380s); probability and statistics; Boole (1854) and Turing (1936); data science.","code":"NUM","name":"Number, Measure \u0026 Time","purpose":"counting, calendars and mathematics, so planning, building, trade and science work. Feeds planners\u0027 foresight and many cross-theme prerequisites.","theme":"reach"},{"anchors":"rafts (Sahul crossing \u2265 ~50\u201365 ka); hide boats; dugouts (Pesse ~8000 BCE); outriggers (Austronesian); plank boats; sail (Egypt ~3000 BCE); harbors and the Pharos (~280 BCE); galleys and triremes; keeled longships and cogs; lateen sail and sternpost rudder; caravels (15th c.); galleons; steamships (1807\u002B); steel hulls; container ships (1956).","code":"SEA","name":"Watercraft \u0026 Seafaring","purpose":"crossing water. Opens islands, coasts, other continents and maritime trade. Water is the biggest barrier on the map and the fastest highway once mastered.","theme":"reach"},{"anchors":"alloparenting; food sharing; exogamy and alliance networks; totemic clans; competitive feasting; Neolithic villages (\u00C7atalh\u00F6y\u00FCk); chiefdoms; craft specialization; urban revolution (Uruk); citizenship (Athens, Rome); guilds; bourgeoisie; labor movement; welfare state (1880s\u20131940s); networked society (1990s\u002B).","code":"SOC","name":"Kinship \u0026 Society","purpose":"the group cap and the settlement tier. Sets how large a community can be before it fissions, and how fission turns into organized expansion. Uses real social-group-size layers (band \u2192 clan/Dunbar \u2192 tribe \u2192 chiefdom \u2192 city \u2192 nation).","theme":"kin"},{"anchors":"Oldowan ~2.6 Ma \u2192 Acheulean ~1.7 Ma \u2192 Levallois ~300 ka \u2192 blades and microliths (Upper Paleolithic) \u2192 polished Neolithic axes \u2192 ashlar masonry.","code":"STN","name":"Stoneworking","purpose":"the first tool tiers. Stone tools multiply nearly every early action, and later stone becomes a building material.","theme":"craft"},{"anchors":"home ranges; seasonal camp circuits; boundary markers and cairns; permanent villages; daughter-village colonization (Neolithic spread); boundary stones (kudurru); city-states; provinces (Persian satrapies, Roman provinces); Greek and Phoenician colonies; manors; overseas colonies; cadastral registries; suburbanization; decolonization (1945\u201375); smart cities.","code":"TER","name":"Claim \u0026 Settlement","purpose":"the rules of owning land. Claim radius, claim strength, how fissioned groups choose new sites, how distant land is held, and how expansion overseas works. The lineage most directly tied to Dominion score.","theme":"reach"},{"anchors":"gift exchange; obsidian and shell networks (~100 ka\u002B); barter; Neolithic exchange; marketplaces; market towns; coinage (Lydia ~600 BCE); Silk Road; banking and bills of exchange (Italy, 13th c.); double-entry bookkeeping (Pacioli 1494); joint-stock companies (VOC 1602); stock exchange (Amsterdam); industrial capitalism; central banking; Bretton Woods and GATT (1944\u201347); e-commerce (1990s); global supply chains.","code":"TRD","name":"Exchange \u0026 Commerce","purpose":"getting what your land lacks (tin, salt, silk, oil) without conquering it; wealth; peaceful contact; diffusion. Trade is the alternative to war for satisfying [Has: \u2026] gates.","theme":"reach"},{"anchors":"tumplines; dog travois; skis (~8000 BCE); pack donkeys; wheeled carts (~3500 BCE); horse riding; Persian and Roman roads; stone bridges; stirrup (~4th c. China; Europe ~8th c.) and horseshoe; turnpikes; canals; railways (1825); automobiles (1886); highways; aviation (1903); containers (1956); high-speed rail (1964\u002B) and EVs.","code":"TRN","name":"Land Transport","purpose":"move and carry. Haul capacity and travel speed decide how far a settlement\u0027s workers can reach, how fast goods flow, and how quickly a civilization can respond on its borders. Hosts the Haul and Travel ladders.","theme":"reach"},{"anchors":"clubs and thrown stones; raiding; archery in conflict (Nataruk ~10 ka); warrior bands; bronze arms and shields; chariots (~2000 BCE); phalanx and legion; iron weapons; siege engines; knights; crossbows and longbows; gunpowder weapons (China, then 14th c. Europe); pike and musket; rifles and artillery; tanks and aircraft (WWI); nuclear weapons (1945); precision and drone warfare; UN peacekeeping (1948\u002B).","code":"WAR","name":"Arms \u0026 Warfare","purpose":"taking land and stores by force, and defending them in the field. War is risky (deaths, Cohesion loss, rival alliances), but it is a legitimate path to Dominion. Posture *Raid* uses it.","theme":"reach"},{"anchors":"landmarks and trails; seasonal rounds; star navigation; sketch maps (Pavlov ~25 ka; Mezhyrich); celestial navigation (Polynesia, Phoenicia); periplus; Ptolemy\u0027s *Geography*; magnetic compass (China ~11th c.); portolans and astrolabe; Harrison\u0027s chronometer (1761); triangulation surveys; aerial photography and radar; GPS (1978\u20131995); GIS.","code":"WAY","name":"Wayfinding \u0026 Cartography","purpose":"vision, exploration, map knowledge and route efficiency. Exploration triggers exposure gates ([Seen: \u2026]), so Wayfinding unlocks research across all three themes.","theme":"reach"},{"anchors":"Sch\u00F6ningen wooden spears ~300 ka; adzes (Neolithic); joinery (Bronze Age); water sawmills (Hierapolis, 3rd c.; medieval Europe); chainsaw (1920s, portable 1950s).","code":"WOD","name":"Woodworking","purpose":"the universal material of the pre-industrial world: tools, shelters, boats, wheels and fuel. Hosts the Chop Wood ladder.","theme":"craft"}],"projects":[{"cost":{"$fix":644245094400},"effects":[{"action":"farm","kind":"unlock_action"},{"kind":"build","structure":"field"},{"action":"farm","kind":"method","name":"Cultivation","rate":4,"rung":1,"unit":"R/tile/yr"},{"cap":"food","kind":"cap","mult":{"$fix":5583457484}}],"era":2,"flavor":"We stopped following the food.","id":"AGR-01","idx":0,"lineage":"AGR","moment":"The first seeds pressed into cleared soil","name":"Cultivation","practice":[{"action":"farm","share":100}],"requires":["FOR-05","FOR-06"],"status":"numeric","theme":"kin","type":"D"},{"cost":{"$fix":644245094400},"effects":[{"action":"farm","kind":"method","name":"Domesticated staple by biome","rate":8,"rung":2,"unit":"R/tile/yr"},{"cap":"food","kind":"cap","mult":{"$fix":5239860101}},{"id":"G-GRAIN","kind":"good"}],"era":2,"flavor":"The plants changed for us, and we for them.","id":"AGR-02","idx":1,"lineage":"AGR","moment":"Plump grain that doesn\u0027t fall from the stalk","name":"Domesticated Staples","practice":[{"action":"farm","share":100}],"requires":["AGR-01"],"status":"numeric","theme":"kin","type":"M"},{"cost":300,"cost":{"$fix":1288490188800},"cost_reason":"docs/MVP/28 \u00A716: late era-2 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"mod","note":"Field yield, \u00D71.08","op":"mult","stat":"field_yield","value":{"$fix":4638564679}},{"kind":"mod","note":"Soil fertility loss, \u00D70.5","op":"mult","stat":"soil_fertility_loss","value":{"$fix":2147483648}},{"cap":"food","kind":"cap","mult":{"$fix":4638564679},"take":{"$fix":2147483648}}],"era":2,"flavor":"The beans feed the soil.","id":"AGR-03","idx":2,"lineage":"AGR","moment":"Lentils and wheat growing side by side","name":"Legume Pairing","practice":[{"action":"farm","share":100}],"requires":["AGR-02"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":644245094400},"effects":[{"action":"clear","kind":"method","mult":1,"name":"Slash-and-burn","note":"forest 1 ws/tile, fields shift every 4 yrs","rung":1}],"era":2,"flavor":"Fire opens the forest.","id":"AGR-04","idx":3,"lineage":"AGR","moment":"A burning forest edge; ash-blackened fields beyond","name":"Slash-and-Burn","practice":[{"action":"farm","share":50},{"action":"tend_fire","share":50}],"requires":["AGR-01","STN-08","FIR-05"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":1717986918400},"effects":[{"action":"farm","kind":"method","name":"Ard plough","note":"field labor \u00D70.5 with one ox pair per 4 fields; yield unchanged","rate":8,"rung":3,"unit":"R/tile/yr"},{"kind":"mod","note":"field limit 25% \u2192 40% of range tiles (07d \u00A710)","op":"set","stat":"field_limit","value":{"$fix":1717986918}},{"cap":"food","kind":"cap","mult":{"$fix":5025111736}}],"era":3,"flavor":"The ox breaks the ground the hoe could not.","id":"AGR-05","idx":4,"lineage":"AGR","moment":"A pair of oxen drag a crooked wooden ard and a straight furrow opens behind them","name":"Ard Plough","practice":[{"action":"farm","share":50},{"action":"herd","share":50}],"requires":["AGR-02","NRG-01"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":4123168604160},"cost":960,"cost_reason":"docs/MVP/28 \u00A716: late era-3 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"build","structure":"canal"},{"kind":"mod","note":"\u00D72 on Arid and Desert tiles, where soil counts 100","op":"mult","stat":"irrigated_yield","value":{"$fix":6442450944}},{"kind":"mod","op":"mult","stat":"flood_loss","value":{"$fix":2147483648}},{"cap":"food","kind":"cap","mult":{"$fix":5025111736}},{"kind":"gate","text":"[Near: River]"}],"era":3,"flavor":"We led the river to the fields.","gates":[{"kind":"near","target":"River"}],"id":"AGR-06","idx":5,"lineage":"AGR","moment":"A reed dam is cut and water runs down a new ditch into dry furrows","name":"Irrigation Canals","practice":[{"action":"farm","share":50},{"action":"build","share":50}],"requires":["AGR-05","NUM-04"],"status":"numeric","theme":"kin","type":"S"},{"cost":{"$fix":1717986918400},"effects":[{"kind":"mod","note":"per harvest 6 \u2192 2.4 on fields with 2 cattle or 6 sheep per 4 fields (with AGR-03: 3 \u2192 1.2)","op":"mult","stat":"soil_fertility_loss","value":{"$fix":1717986918}},{"cap":"food","kind":"cap","mult":{"$fix":4724464025},"take":{"$fix":2576980377}}],"era":3,"flavor":"The herds feed the fields that feed the herds.","id":"AGR-07","idx":6,"lineage":"AGR","moment":"Cattle graze a resting field while a boy spreads dung along last year\u0027s furrows","name":"Fallow \u0026 Manuring","practice":[{"action":"farm","share":50},{"action":"herd","share":50}],"requires":["AGR-05","HUS-04"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":6184752906000},"effects":[{"kind":"build","note":"one farmable plot on eligible hill/mountain tile; materials paid","structure":"terrace"}],"era":4,"flavor":"The hillside holds a field.","id":"AGR-08","idx":7,"lineage":"AGR","moment":"A retaining wall makes a level strip on the slope.","name":"Terracing","practice":[{"action":"farm","share":100}],"requires":["AGR-06","STN-11"],"status":"numeric","theme":"kin","type":"S"},{"cost":{"$fix":5153960755200},"effects":[{"action":"farm","kind":"method","mult":{"$fix":8589934592},"name":"iron_scythe","note":"crop output only; no population-food grant","rung":4,"stage":"harvest","tool":"t11"}],"era":4,"flavor":"One stroke gathers what many hands once cut.","id":"AGR-09","idx":8,"lineage":"AGR","moment":"A curved iron blade sweeps through ripe grain.","name":"Iron Sickle \u0026 Scythe","practice":[{"action":"farm","share":100}],"requires":["AGR-05","MET-09"],"status":"numeric","theme":"kin","type":"M"},{"cost":2400,"cost":{"$fix":10307921510400},"cost_reason":"docs/MVP/28 \u00A77: late Iron project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"action":"till","kind":"method","mult":{"$fix":4294967296},"name":"mouldboard","note":"heavy-clay eligibility changes; no universal output bonus","rung":1},{"kind":"rule","text":"heavy-clay temperate-forest plot becomes prime farmland; KEY-5 prerequisite; no universal output bonus"}],"era":4,"flavor":"The heavy ground opens to seed.","id":"AGR-10","idx":9,"lineage":"AGR","moment":"A mouldboard turns thick soil aside.","name":"Heavy Plough","practice":[{"action":"farm","share":100}],"requires":["AGR-09","NRG-02"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":27487790694400},"effects":[{"kind":"mod","note":"rotated fields: cropped share 1/2 to 2/3 (x1.333) with a legume yield x1.125 (P, e5_economy_oracle)","op":"mult","stat":"field_output","value":{"$fix":6442450944}},{"kind":"rule","text":"One field in three lies fallow each year and is grazed; the \u002B50% is physical (cropped share and legume nitrogen), not a free multiplier on top of the Heavy Plough."}],"era":5,"flavor":"Every field rests in its turn.","id":"AGR-11","idx":10,"lineage":"AGR","moment":"Three strips lie side by side: wheat, beans, fallow.","name":"Three-Field Rotation","practice":[{"action":"farm","share":100}],"requires":["AGR-10","AGR-03"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":51539607552000},"effects":[{"kind":"mod","note":"fallow is replaced by fodder and legume in a four-course rotation. Only half the land bears grain, so the gain is manure and fed livestock; e6_economy_oracle Part A finds x0.9 to x1.3 over three-field and x1.5 only with an unrealistic conversion, so the field step is x1.2 and HUS-11 carries the rest (P)","op":"mult","stat":"field_output","value":{"$fix":5153960755}},{"kind":"mod","note":"enclosed, hedged fields need fewer hands; the freed adults move to towns, they are not erased (P)","op":"mult","stat":"farm_labor_per_output","value":{"$fix":3650722201}},{"kind":"rule","text":"Fodder fed in the stall feeds more livestock (HUS-11); the rural labor released is shown as people moved to town work. In the sim half the strips bear grain each year (9/5 of a strip, an average of 0.9 against the three-field\u0027s 0.75) and the fields need 0.85 of the cropped labor (P, docs/MVP/38 \u00A75.5)."}],"era":6,"flavor":"Clover feeds the soil and the cattle together.","id":"AGR-12","idx":11,"lineage":"AGR","moment":"A farmer sows turnips where a fallow field once lay.","name":"Four-Course Rotation \u0026 Enclosure","practice":[{"action":"farm","share":100}],"requires":["AGR-11","HUS-10","TER-10"],"status":"numeric","theme":"kin","type":"M"},{"cost":{"$fix":1202590842880000},"effects":[{"kind":"prose","text":"\u25B8 Sow/Harvest: Machine \u00D73; farm labor \u221240%."}],"era":7,"id":"AGR-13","idx":12,"lineage":"AGR","name":"Seed Drill \u0026 Mechanical Reaper","requires":["AGR-12","MEC-11"],"status":"draft","theme":"kin","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"\u25B8 Till/Harvest: Motorized \u00D74; farm labor \u221280%."}],"era":8,"id":"AGR-14","idx":13,"lineage":"AGR","name":"Tractors \u0026 Combines","requires":["AGR-13","NRG-10"],"status":"draft","theme":"kin","type":"M"},{"cost":{"$fix":7301444403200000},"effects":[{"kind":"prose","text":"High-yield varieties with fertilizer: yield \u00D72. Famine nearly ends where adopted."}],"era":8,"id":"AGR-15","idx":14,"lineage":"AGR","name":"Green Revolution","requires":["AGR-14","CHM-12","FOR-11"],"status":"draft","theme":"kin","type":"M"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"GPS and sensors: inputs \u221230%, yield \u002B20%, pollution \u2212."}],"era":9,"id":"AGR-16","idx":15,"lineage":"AGR","name":"Precision Farming","requires":["AGR-15","MEC-15","WAY-13"],"status":"draft","theme":"kin","type":"M"},{"cost":{"$fix":38654705664000000},"effects":[{"kind":"prose","text":"Drought and pest resistant: crop failures \u221250%; marginal biomes farmable."}],"era":9,"id":"AGR-17","idx":16,"lineage":"AGR","name":"Genetically Engineered Crops","requires":["AGR-15","INQ-20"],"status":"draft","theme":"kin","type":"M"},{"cost":{"$fix":94489280512},"effects":[{"id":"G-BEADS","kind":"good"},{"kind":"cohesion","value":2},{"kind":"rule","text":"First tradeable good"}],"era":0,"flavor":"This is who we are.","id":"ART-01","idx":17,"lineage":"ART","moment":"Shell beads strung on cord, held up to the sun","name":"Beads \u0026 Body Ornament","practice":[{"action":"craft","share":50},{"action":"socialize","share":50}],"requires":["SOC-01"],"status":"numeric","theme":"kin","type":"D"},{"cost":66,"cost":{"$fix":283467841536},"cost_reason":"docs/MVP/28 \u00A716: late era-0 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"know_how","text":"\u002B20%"},{"kind":"cohesion","note":"per season at a hearth","value":1}],"era":0,"flavor":"The story of the bear kept us from the bear.","id":"ART-02","idx":18,"lineage":"ART","moment":"An elder acts out a hunt by firelight; children laugh","name":"Storytelling","practice":[{"action":"tell_stories","share":100}],"requires":["ART-01","COM-02"],"status":"numeric","theme":"kin","type":"I"},{"cost":{"$fix":214748364800},"effects":[{"kind":"claim","text":"\u002B0.5, radius 3 around painted sites"},{"kind":"cohesion","value":3},{"kind":"know_how","text":"HNT, \u002B10%"}],"era":1,"flavor":"Paint the herd, and it returns.","id":"ART-03","idx":19,"lineage":"ART","moment":"Torchlight on a cave wall where a painted aurochs seems to move","name":"Cave Painting","practice":[{"action":"craft","share":50},{"action":"ritual","share":50}],"requires":["ART-02","CHM-01"],"status":"numeric","theme":"kin","type":"D"},{"cost":100,"cost":{"$fix":429496729600},"cost_reason":"docs/MVP/28 \u00A716: late era-1 project (prerequisite depth \u003E= 3) costs 2x the derived cost so research slows toward the end of the age","effects":[{"kind":"cohesion","value":3},{"kind":"mod","note":"Feast and gathering effect, \u002B25%","op":"pct","stat":"feast_and_gathering_effect","value":{"$fix":1073741824}}],"era":1,"flavor":"Music made us one body.","id":"ART-04","idx":20,"lineage":"ART","moment":"A bone flute plays; feet stamp in rhythm","name":"Music \u0026 Dance","practice":[{"action":"ritual","share":50},{"action":"socialize","share":50}],"requires":["ART-02","STN-07"],"status":"numeric","theme":"kin","type":"D"},{"cost":{"$fix":322122547200},"effects":[{"kind":"lever","text":"Beacon \u002B1"},{"kind":"mod","note":"Travel speed in known land, \u002B30%","op":"pct","stat":"travel_speed_in_known_land","value":{"$fix":1288490188}}],"era":1,"flavor":"The song is the path.","id":"ART-05","idx":21,"lineage":"ART","moment":"A wanderer sings the way across the desert","name":"Songlines","practice":[{"action":"scout","share":50},{"action":"tell_stories","share":50}],"requires":["ART-02","WAY-02"],"status":"numeric","theme":"kin","type":"I"},{"cost":{"$fix":1717986918400},"effects":[{"kind":"mod","op":"mult","stat":"wonder_cohesion","value":{"$fix":5368709120}},{"kind":"mod","note":"Wonder Cohesion radius 8 \u2192 10","op":"mult","stat":"wonder_radius","value":{"$fix":5368709120}},{"kind":"rule","text":"one Legend per se