acy","text":"Keystone"},{"kind":"rule","text":"Normal keystone event and score only; no free ships, population or E6 systems; oceans open as a rule of the Discovery chapter, not here."}],"enters":6,"era":5,"flavor":"Words, ledgers, compasses and schools open the wider world.","id":"KEY-6","idx":267,"lineage":"KEY","moment":"A press, a ledger, a compass and a lecture hall are shown together.","name":"Printing Revolution","practice":[{"action":"scribe","share":100}],"requires":["COM-10","TRD-09","WAY-08","LRN-08"],"status":"numeric","theme":"key","type":"K"},{"breadth":{"era":6,"min":14},"cost":{"$fix":128849018880000},"effects":[{"era":7,"kind":"era_advance"},{"kind":"legacy","text":"Keystone"},{"kind":"rule","text":"Normal keystone event and score only; no free ships, population or E7 systems; the pollution system and the Industry rules arrive with the Industry chapter, not here."}],"enters":7,"era":6,"flavor":"Steam, thread, capital and method turn a trade into an age.","id":"KEY-7","idx":268,"lineage":"KEY","moment":"A boiler, a loom, a ledger and a laboratory bench are shown together.","name":"Industrial Revolution","practice":[{"action":"scribe","share":50},{"action":"build","share":50}],"requires":["NRG-06","MEC-10","TRD-10","INQ-08"],"status":"numeric","theme":"key","type":"K"},{"breadth":{"era":7,"min":14},"cost":{"$fix":3006477107200000},"effects":[{"kind":"prose","text":"Modern era; scale 1:250; night lights on the map."}],"enters":8,"era":7,"id":"KEY-8","idx":269,"lineage":"KEY","name":"Electrification","requires":["NRG-08","COM-12","TRN-12","MED-11"],"status":"draft","theme":"key","type":"K"},{"breadth":{"era":8,"min":18},"cost":{"$fix":18253611008000000},"effects":[{"kind":"prose","text":"Information (post-modern) era; scale 1:500; data-link layer appears on the map."}],"enters":9,"era":8,"id":"KEY-9","idx":270,"lineage":"KEY","name":"Digital Revolution","requires":["INQ-18","MEC-13","LRN-11","TRD-14"],"status":"draft","theme":"key","type":"K"},{"cost":{